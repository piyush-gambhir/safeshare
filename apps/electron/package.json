{
  "name": "safeshare-electron",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite build && ELECTRON_START_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "build": "node node_modules/@typescript/native/bin/tsc && vite build && electron-builder",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:compat": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/transfers.test.ts"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@types/webtorrent": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "webtorrent": "3.0.21",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.5.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "main": "dist-electron/main.js"
}
